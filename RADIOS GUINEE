    catMus: "موسيقى", catInfo: "أخبار", catRel: "دين", catReg: "محلي", langTitle: "اللغات"
  },
  nko: {
    dir: "rtl", subtitle: "ߘߍ߬ߡߊ߬ ߞߊ߲ߠߊ߬ ߛߓߍߟߌ", search: "ߞߊ߬ ߙߊߘߌߦߐ ߟߊ߫ ߦߋ߫...", sectionRadios: "📻 ߙߊߘߌߦߐ ߞߊ߲ߠߊ",
    navHome: "ߙߊߘߌߦߐ", navFavs: "ߒߠߋ ߟߊ߫", navPodcasts: "ߝߐߟߌ", navAbout: "ߒߠߋ ߟߊ߫", langModal: "ߞߊ߲ ߟߊ߫ ߦߋ߫",
    favTitle: "ߒ ߠߊ߫ ߙߊߘߌߦߐ", emptyFav: "ߙߊߘߌߦߐ ߛߌ߫ ߕߴߛߋ߫", podcastTitle: "ߝߐߟߌ", emptyPod: "ߝߐߟߌ ߘߌ߫ ߛߋ߫",
    aboutTitle: "ߒߠߋ ߟߊ߫", aboutText: "RADIOS GUINÉE ߞߊ߬ ߙߊߘߌߦߐ ߓߘߍ߬ ߘߊ߫ ߖߌ߬ߣߍ߫ ߡߊ߬.",
    pubContactTitle: "ߞߊ߬ߙߊ߲", pubContactText: "ߌ ߦߋ߫ ߞߊ߬ ߌ ߟߊ߫ ߞߊ߬ߙߊ߲ ߘߊ߫?", versionTitle: "ߞߐߜߍ",
    pubText: "📢 ߌ ߟߊ߫ ߞߊ߬ߙߊ߲ ߦߋ߫ ߟߊ", pubMidText: "ߌ ߟߊ߫ ߞߊ߬ߙߊ߲ ߘߊ߫!", pubCta: "ߘߊ߬ߡߊ",
    loading: "ߟߊ߬ߘߌ߬ߟߌ...", live: "ߞߊ߲ߠߊ", catAll: "ߒߞߏ", catGen: "ߝߊ߬ߙߊ߲",
    catMus: "ߘߣߊ߬ߡߊ", catInfo: "ߞߐߜߍ", catRel: "ߌߛߌ߬ߟߊ߬ߡߊ", catReg: "ߝߊ߬ߛߏ", langTitle: "ߞߊ߲ ߘߐ߫"
  }
};

// =====================
// STATE & VARIABLES GLOBALLES
// =====================
let currentLang = 'fr';
let currentRadio = null;
let isPlaying = false;
let favorites = JSON.parse(localStorage.getItem('rg_favs') || '[]');
let currentCategory = 'all';
let currentSearch = '';
let radios = []; // Rempli dynamiquement par l'API

const audio = document.getElementById('audioPlayer');

// Couleurs de secours et emojis pour le design de vos cartes
const designMap = {
  "espace": { color: "#0066CC", emoji: "📡" },
  "rtg": { color: "#006600", emoji: "📺" },
  "sabari": { color: "#990099", emoji: "🎵" },
  "sweet": { color: "#CC6600", emoji: "🍯" },
  "bonheur": { color: "#009966", emoji: "🌙" },
  "love": { color: "#CC0066", emoji: "💕" },
  "littoral": { color: "#006699", emoji: "🌊" },
  "fouta": { color: "#996600", emoji: "⛰️" },
  "nostalgie": { color: "#663399", emoji: "🎶" },
  "soleil": { color: "#CC9900", emoji: "☀️" },
  "djoma": { color: "#336600", emoji: "🌿" },
  "lynx": { color: "#CC3300", emoji: "🦁" }
};

// =====================
// CHARGEMENT DYNAMIQUE DE L'API
// =====================
async function loadRadiosFromAPI() {
  try {
    // Appel sécurisé à Radio Browser pour récupérer uniquement la Guinée (GN)
    const response = await fetch("https://de1.api.radio-browser.info/json/stations/bycountrycodeexact/gn");
    const data = await response.json();
    
    // Formatage pour correspondre exactement à votre structure de données initiale
    radios = data.map((station, index) => {
      const nameLower = station.name.toLowerCase();
      
      // On tente de faire correspondre avec vos magnifiques designs prédéfinis
      let matchedKey = "generaliste";
      let color = "#2A2A2A";
      let emoji = "📻";
      
      for (const key in designMap) {
        if (nameLower.includes(key)) {
          color = designMap[key].color;
          emoji = designMap[key].emoji;
          break;
        }
      }

      // Catégorisation automatique simple
      let category = "generaliste";
      if (nameLower.includes("musique") || nameLower.includes("sweet") || nameLower.includes("love") || nameLower.includes("nostalgie")) category = "musique";
      if (nameLower.includes("info") || nameLower.includes("rtg") || nameLower.includes("lynx")) category = "info";
      if (nameLower.includes("bonheur") || nameLower.includes("islam") || nameLower.includes("coran")) category = "religion";
      if (nameLower.includes("fouta") || nameLower.includes("djoma") || nameLower.includes("labé") || nameLower.includes("nzerekore")) category = "regional";

      return {
        id: station.stationuuid, // Identifiant unique de l'API
        name: station.name,
        freq: station.homepage && station.homepage.includes("FM") ? "Direct Web" : "FM / Stream",
        desc: station.tags ? station.tags.split(',').slice(0,2).join(' ') : "Votre radio en direct",
        category: category,
        color: color,
        stream: station.url_resolved, // Le vrai lien direct du flux audio HTTPS résolu !
        favicon: station.favicon, // Utilisation du logo de l'API si disponible
        emoji: emoji
      };
    });

    renderRadios(getFilteredRadios(), 'radio-list');
  } catch (error) {
    console.error("Erreur de chargement de l'API Radio-Browser:", error);
    document.getElementById('radio-list').innerHTML = `<div class="empty-state"><div class="empty-icon">⚠️</div><div class="empty-text">Erreur de connexion. Veuillez rafraîchir la page.</div></div>`;
  }
}

// =====================
// RENDER RADIOS
// =====================
function renderRadios(list, containerId) {
  const container = document.getElementById(containerId);
  if (!list.length) {
    container.innerHTML = `<div class="empty-state"><div class="empty-icon">📻</div><div class="empty-text">${i18n[currentLang].emptyFav}</div></div>`;
    return;
  }
  container.innerHTML = list.map(r => {
    // Si l'API fournit un logo valide, on l'utilise, sinon on garde vos magnifiques boîtes de couleurs
    const logoHtml = r.favicon && r.favicon.startsWith('http') 
      ? `<div class="radio-logo"><img src="${r.favicon}" onerror="this.style.display='none';this.parentElement.innerHTML='${r.emoji}'"/></div>`
      : `<div class="logo-placeholder" style="background:${r.color};">${r.emoji}<br/><span style="font-size:9px">${r.name.split(' ')[0]}</span></div>`;

    return `
      <div class="radio-card ${currentRadio && currentRadio.id === r.id ? 'playing' : ''}" id="card-${r.id}" onclick="playRadio('${r.id}')">
        ${logoHtml}
        <div class="radio-info">
          <div class="radio-name">${r.name}</div>
          <div class="radio-desc">${r.desc}</div>
          <div class="radio-freq">${r.freq}</div>
          <span class="radio-cat">${getCatLabel(r.category)}</span>
        </div>
        <div class="radio-actions">
          <button class="play-btn ${currentRadio && currentRadio.id === r.id && isPlaying ? 'playing' : ''}" onclick="event.stopPropagation(); playRadio('${r.id}')">
            ${currentRadio && currentRadio.id === r.id && isPlaying ? '⏸' : '▶'}
          </button>
          <button class="fav-btn ${favorites.includes(r.id) ? 'active' : ''}" onclick="event.stopPropagation(); toggleFav('${r.id}')">
            ${favorites.includes(r.id) ? '❤️' : '🤍'}
          </button>
        </div>
      </div>
    `;
  }).join('');
}

function getCatLabel(cat) {
  const t = i18n[currentLang];
  const map = { all: t.catAll, generaliste: t.catGen, musique: t.catMus, info: t.catInfo, religion: t.catRel, regional: t.catReg };
  return map[cat] || cat;
}

function getFilteredRadios() {
  return radios.filter(r => {
    const matchCat = currentCategory === 'all' || r.category === currentCategory;
    const matchSearch = !currentSearch || r.name.toLowerCase().includes(currentSearch.toLowerCase()) || r.desc.toLowerCase().includes(currentSearch.toLowerCase());
    return matchCat && matchSearch;
  });
}

function filterCategory(cat, btn) {
  currentCategory = cat;
  document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderRadios(getFilteredRadios(), 'radio-list');
}

function filterRadios(val) {
  currentSearch = val;
  renderRadios(getFilteredRadios(), 'radio-list');
}

// =====================
// CONTROLE DE LECTURE (PLAY)
// =====================
function playRadio(id) {
  const radio = radios.find(r => r.id === id);
  if (!radio) return;

  if (currentRadio && currentRadio.id === id) {
    togglePlay();
    return;
  }

  currentRadio = radio;
  isPlaying = true;

  // Mise à jour de l'interface du lecteur du bas
  document.getElementById('playerBar').classList.add('visible');
  document.getElementById('playerName').textContent = radio.name;
  
  const playerLogoContainer = document.getElementById('playerLogo');
  if(radio.favicon && radio.favicon.startsWith('http')) {
    playerLogoContainer.innerHTML = `<img src="${radio.favicon}" style="width:100%;height:100%;border-radius:10px;object-fit:cover"/>`;
  } else {
    playerLogoContainer.innerHTML = radio.emoji;
    playerLogoContainer.style.background = radio.color;
  }

  document.getElementById('mainPlayBtn').textContent = '⏸️';
  document.getElementById('liveStatus').style.display = 'inline-flex';
  document.getElementById('loadingText').style.display = 'inline';
  document.getElementById('loadingText').textContent = i18n[currentLang].loading;

  // Chargement et démarrage du flux audio
  audio.src = radio.stream;
  audio.volume = document.getElementById('volumeSlider').value / 100;
  
  audio.play().then(() => {
    document.getElementById('loadingText').style.display = 'none';
  }).catch((err) => {
    console.error("Erreur de lecture : ", err);
    document.getElementById('loadingText').textContent = '⚠️ Flux instable ou indisponible';
  });

  renderRadios(getFilteredRadios(), 'radio-list');
  renderFavs();
}

function togglePlay() {
  if (!currentRadio) return;
  if (isPlaying) {
    audio.pause();
    isPlaying = false;
    document.getElementById('mainPlayBtn').textContent = '▶️';
  } else {
    audio.play().then(() => {
       document.getElementById('loadingText').style.display = 'none';
    }).catch(() => {
       document.getElementById('loadingText').textContent = '⚠️ Erreur de flux';
    });
    isPlaying = true;
    document.getElementById('mainPlayBtn').textContent = '⏸️';
  }
  renderRadios(getFilteredRadios(), 'radio-list');
  renderFavs();
}

function closePLayer() {
  audio.pause();
  audio.src = '';
  currentRadio = null;
  isPlaying = false;
  document.getElementById('playerBar').classList.remove('visible');
  renderRadios(getFilteredRadios(), 'radio-list');
  renderFavs();
}

function setVolume(val) {
  audio.volume = val / 100;
}

// =====================
// FAVORITES
// =====================
function toggleFav(id) {
  if (favorites.includes(id)) {
    favorites = favorites.filter(f => f !== id);
  } else {
    favorites.push(id);
  }
  localStorage.setItem('rg_favs', JSON.stringify(favorites));
  renderRadios(getFilteredRadios(), 'radio-list');
  renderFavs();
}

function renderFavs() {
  const favRadios = radios.filter(r => favorites.includes(r.id));
  const container = document.getElementById('fav-list');
  if (!favRadios.length) {
    container.innerHTML = `<div class="empty-state"><div class="empty-icon">💔</div><div class="empty-text">${i18n[currentLang].emptyFav}</div></div>`;
    return;
  }
  renderRadios(favRadios, 'fav-list');
}

// =====================
// GESTION DES ONGLETS
// =====================
function switchTab(tab, navEl) {
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('tab-' + tab).classList.add('active');
  navEl.classList.add('active');
  if (tab === 'favs') renderFavs();
}

// =====================
// SYSTEME DE TRADUCTION & MODAL
// =====================
function openLangModal() { document.getElementById('langModal').classList.add('open'); }
function closeLangModal(e) { if (e.target === document.getElementById('langModal')) { document.getElementById('langModal').classList.remove('open'); } }

function setLanguage(lang) {
  currentLang = lang;
  document.getElementById('langModal').classList.remove('open');
  applyLanguage();
  renderRadios(getFilteredRadios(), 'radio-list');
  renderFavs();
}

function applyLanguage() {
  const t = i18n[currentLang];
  document.documentElement.dir = t.dir;
  document.documentElement.lang = currentLang;

  const flags = { fr: '🇫🇷 FR', en: '🇬🇧 EN', ar: '🌙 AR', nko: '✨ NKO' };
  document.getElementById('lang-display').textContent = flags[currentLang];
  document.getElementById('app-subtitle').textContent = t.subtitle;
  document.getElementById('searchInput').placeholder = t.search;
  document.getElementById('section-radios').textContent = t.sectionRadios;
  document.getElementById('nav-home').textContent = t.navHome;
  document.getElementById('nav-favs').textContent = t.navFavs;
  document.getElementById('nav-podcasts').textContent = t.navPodcasts;
  document.getElementById('nav-about').textContent = t.navAbout;
  document.getElementById('lang-modal-title').textContent = t.langModal;
  document.getElementById('fav-title').textContent = t.favTitle;
  document.getElementById('podcast-title').textContent = t.podcastTitle;
  document.getElementById('empty-pod-text').textContent = t.emptyPod;
  document.getElementById('about-title').textContent = t.aboutTitle;
  document.getElementById('about-text').textContent = t.aboutText;
  document.getElementById('pub-contact-title').textContent = t.pubContactTitle;
  document.getElementById('pub-contact-text').textContent = t.pubContactText;
  document.getElementById('version-title').textContent = t.versionTitle;
  document.getElementById('pub-text').textContent = t.pubText;
  document.getElementById('pub-mid-text').textContent = t.pubMidText;
  document.getElementById('pub-cta').textContent = t.pubCta;
  document.getElementById('liveStatus').textContent = t.live;
  document.getElementById('lang-title-about').textContent = t.langTitle;

  const catBtns = document.querySelectorAll('.cat-btn');
  const catKeys = ['catAll', 'catGen', 'catMus', 'catInfo', 'catRel', 'catReg'];
  catBtns.forEach((btn, i) => { if (catKeys[i]) btn.textContent = t[catKeys[i]]; });

  ['fr','en','ar','nko'].forEach(l => {
    document.getElementById('lang-' + l).classList.toggle('selected', l === currentLang);
  });
}

// =====================
// INITIALISATION
// =====================
window.onload = function() {
  applyLanguage();
  loadRadiosFromAPI(); // On lance le chargement en direct de la base mondiale
};
</script>
